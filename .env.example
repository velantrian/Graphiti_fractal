NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace-with-a-strong-local-password

OPENAI_API_KEY=replace-with-your-openai-api-key
FRACTAL_API_TOKEN=replace-with-a-long-random-local-token

# Optional
NEO4J_DATABASE=neo4j
FRACTAL_BOOTSTRAP_USER_ID=sergey
FRACTAL_MAX_UPLOAD_BYTES=10485760
# Destructive operations stay disabled unless explicitly enabled:
FRACTAL_ALLOW_HARD_DELETE=0
FRACTAL_ALLOW_CLEAR_ALL=0
