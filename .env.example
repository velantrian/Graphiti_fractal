NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace-with-a-strong-local-password

OPENAI_API_KEY=replace-with-your-openai-api-key

# Active model policy (2026-08-24).
# Terra = balanced capability/cost, Luna = lower-cost/high-volume work.
OPENAI_MODEL=gpt-5.6-terra
CHAT_OPENAI_MODEL=gpt-5.6-terra
SUMMARY_OPENAI_MODEL=gpt-5.6-luna
GRAPHITI_OPENAI_MODEL=gpt-5.6-terra
GRAPHITI_OPENAI_SMALL_MODEL=gpt-5.6-luna
GRAPHITI_OPENAI_REASONING_EFFORT=none
EMBEDDING_MODEL=text-embedding-3-small

FRACTAL_API_TOKEN=replace-with-a-long-random-local-token
FRACTAL_USER_ID=sergey

# Adaptive pre-reply memory retrieval: off | auto | always.
# auto skips only clearly trivial turns and recalls for substantive/ambiguous queries.
FRACTAL_MEMORY_RECALL=auto

# Optional
NEO4J_DATABASE=neo4j
FRACTAL_MAX_UPLOAD_BYTES=10485760

# Destructive operations stay disabled unless explicitly enabled.
FRACTAL_ALLOW_HARD_DELETE=0
FRACTAL_ALLOW_CLEAR_ALL=0
